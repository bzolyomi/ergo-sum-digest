<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.ergosum.digest</string>
  <key>ProgramArguments</key><array>
    <string>__REPO__/.venv/bin/python</string>
    <string>__REPO__/scripts/run_if_due.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer>
  </dict>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/.ergo-sum/run.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.ergo-sum/run.log</string>
</dict></plist>
